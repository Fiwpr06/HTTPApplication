<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.fiwpr06.httpapplication.client.controller.DownloadController"
      spacing="14" prefWidth="760" prefHeight="500"
      style="-fx-background-color: #F8FAFC; -fx-padding: 20;">

    <VBox spacing="4">
        <Text text="📥 Trình Quản Lý Tải Xuống (Download Manager)" style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-fill: #0F172A;"/>
        <Text text="Theo dõi tiến trình, tốc độ truyền tải và trạng thái các tệp tin tải về máy tính." style="-fx-font-size: 13px; -fx-fill: #64748B;"/>
    </VBox>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Button text="📂 Mở Thư Mục Tải Về" onAction="#handleOpenFolder" style="-fx-background-color: #0284C7; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 7 14; -fx-cursor: hand; -fx-background-radius: 6;"/>
        <Button text="🗑️ Xóa tệp đã hoàn thành" onAction="#handleClearCompleted" style="-fx-background-color: #64748B; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 7 14; -fx-cursor: hand; -fx-background-radius: 6;"/>
    </HBox>

    <TableView fx:id="tblDownloads" VBox.vgrow="ALWAYS">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="colFileName" text="Tên tệp tin" minWidth="180"/>
            <TableColumn fx:id="colStatus" text="Trạng thái" minWidth="95" maxWidth="110"/>
            <TableColumn fx:id="colProgress" text="Tiến trình tải" minWidth="160"/>
            <TableColumn fx:id="colSpeed" text="Tốc độ" minWidth="85" maxWidth="100"/>
            <TableColumn fx:id="colSize" text="Dung lượng" minWidth="120" maxWidth="140"/>
        </columns>
    </TableView>

</VBox>
