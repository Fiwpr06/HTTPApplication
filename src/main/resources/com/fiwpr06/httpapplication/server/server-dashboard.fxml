<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.fiwpr06.httpapplication.server.controller.ServerController"
            prefWidth="900" prefHeight="620"
            style="-fx-background-color: #0F172A; -fx-font-family: 'Segoe UI', sans-serif;">

    <!-- Top Header -->
    <top>
        <VBox spacing="12" style="-fx-background-color: #1E293B; -fx-padding: 16 20; -fx-border-color: #334155; -fx-border-width: 0 0 1 0;">
            <HBox alignment="CENTER_LEFT" spacing="16">
                <VBox spacing="2" HBox.hgrow="ALWAYS">
                    <Text text="⚡ MÁY CHỦ HTTP WEB SERVER (LAB 4 - LTM)" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-fill: #F8FAFC;"/>
                    <Text text="Phục vụ giao thức HTTP/1.1: Xem video (Range 206), nghe nhạc, đọc PDF, tải zip, xử lý POST" style="-fx-font-size: 13px; -fx-fill: #94A3B8;"/>
                </VBox>
                <Label fx:id="lblDbBadge" text="CSDL: SQLITE" style="-fx-background-color: #0284C7; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 11px; -fx-padding: 4 10; -fx-background-radius: 12;"/>
                <Label fx:id="lblStatusBadge" text="🔴 MÁY CHỦ ĐANG TẮT" style="-fx-background-color: #EF4444; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 12px; -fx-padding: 6 12; -fx-background-radius: 12;"/>
            </HBox>

            <!-- Control Bar -->
            <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 4 0 0 0;">
                <Label text="Cổng Port:" style="-fx-text-fill: #E2E8F0; -fx-font-weight: bold;"/>
                <TextField fx:id="txtPort" text="8080" prefWidth="75" style="-fx-font-size: 13px; -fx-padding: 6 8;"/>

                <Button fx:id="btnStartServer" text="▶ Bật Máy Chủ" onAction="#handleStartServer" style="-fx-background-color: #16A34A; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 7 16; -fx-cursor: hand; -fx-background-radius: 6;"/>
                <Button fx:id="btnStopServer" text="⏹ Tắt Máy Chủ" onAction="#handleStopServer" style="-fx-background-color: #DC2626; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 7 16; -fx-cursor: hand; -fx-background-radius: 6;" disable="true"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Button text="📂 Mở Thư Mục Web" onAction="#handleBrowseWebRoot" style="-fx-background-color: #334155; -fx-text-fill: #E2E8F0; -fx-font-weight: 600; -fx-padding: 7 12; -fx-cursor: hand; -fx-background-radius: 6;"/>
                <Button text="🌐 Mở Thử Trình Duyệt" onAction="#handleOpenBrowser" style="-fx-background-color: #0284C7; -fx-text-fill: white; -fx-font-weight: 600; -fx-padding: 7 14; -fx-cursor: hand; -fx-background-radius: 6;"/>
                <Button text="🗑️ Xóa Log" onAction="#handleClearScreen" style="-fx-background-color: #475569; -fx-text-fill: #E2E8F0; -fx-font-weight: 600; -fx-padding: 7 12; -fx-cursor: hand; -fx-background-radius: 6;"/>
            </HBox>
        </VBox>
    </top>

    <!-- Center: Simple Live Terminal Log -->
    <center>
        <VBox spacing="8" style="-fx-padding: 14 20;">
            <Label text="📜 Nhật Ký Hoạt Động Của Máy Chủ (Server Real-time Console Log):" style="-fx-text-fill: #CBD5E1; -fx-font-weight: bold; -fx-font-size: 13px;"/>
            <TextArea fx:id="txtConsoleLog" editable="false" wrapText="true" VBox.vgrow="ALWAYS"
                      style="-fx-control-inner-background: #020617; -fx-text-fill: #38BDF8; -fx-font-family: 'Consolas', monospace; -fx-font-size: 13px; -fx-border-color: #334155; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 8;"/>
        </VBox>
    </center>

    <!-- Bottom: Summary Stats -->
    <bottom>
        <HBox spacing="20" alignment="CENTER_LEFT" style="-fx-background-color: #1E293B; -fx-padding: 10 20; -fx-border-color: #334155; -fx-border-width: 1 0 0 0;">
            <Label fx:id="lblSummary" text="📊 Tổng yêu cầu đã nhận: 0 | Tổng lưu lượng: 0 B | Địa chỉ IP: 127.0.0.1" style="-fx-text-fill: #94A3B8; -fx-font-size: 13px; -fx-font-weight: 500;"/>
        </HBox>
    </bottom>

</BorderPane>
