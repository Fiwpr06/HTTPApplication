<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.fiwpr06.httpapplication.server.controller.ServerController"
            prefWidth="980" prefHeight="680"
            stylesheets="@server.css"
            styleClass="root">

    <!-- Top Header & Connection Guide -->
    <top>
        <VBox spacing="10">
            <!-- Header HUD Bar -->
            <HBox styleClass="hud-bar">
                <Label text="HTTP" styleClass="hud-tag"/>
                <VBox spacing="2" HBox.hgrow="ALWAYS">
                    <Text text="HTTP MULTI-SERVICE APPLICATION SERVER" styleClass="hud-title"/>
                    <Text text="Phục vụ 3 dịch vụ mạng: Xem PDF (.pdf) • Stream Nhạc (.mp3) • Stream Video (.mp4)" styleClass="hud-sub"/>
                </VBox>
                <Label fx:id="lblDbBadge" text="CSDL: SQLITE" styleClass="hud-badge-db"/>
                <Label fx:id="lblStatusBadge" text="MAY CHU DANG TAT" styleClass="status-badge-stopped"/>
            </HBox>

            <!-- Network Access Info Cards (Light & High Legibility) -->
            <VBox spacing="10" style="-fx-padding: 0 20;">
                <HBox spacing="14" alignment="CENTER_LEFT">
                    <!-- Local Card -->
                    <HBox spacing="10" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS" styleClass="card-local">
                        <Label text="LOCAL" styleClass="badge-local-tag"/>
                        <VBox spacing="2" HBox.hgrow="ALWAYS">
                            <Label text="Truy cập trên máy này:" style="-fx-text-fill: #475569; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                            <Label fx:id="lblLocalUrl" text="http://localhost:8080/" styleClass="url-local-text"/>
                        </VBox>
                        <Button text="Mở Trình Duyệt" onAction="#handleOpenBrowser" styleClass="btn-utility-blue"/>
                    </HBox>

                    <!-- LAN Card -->
                    <HBox spacing="10" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS" styleClass="card-lan">
                        <Label text="LAN" styleClass="badge-lan-tag"/>
                        <VBox spacing="2" HBox.hgrow="ALWAYS">
                            <Label text="Điện thoại / Máy khác (cùng Wi-Fi):" style="-fx-text-fill: #047857; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                            <Label fx:id="lblLanUrl" text="http://192.168.1.1:8080/" styleClass="url-lan-text"/>
                        </VBox>
                        <Button text="Sao Chép URL" onAction="#handleCopyLanUrl" styleClass="btn-utility-green"/>
                    </HBox>
                </HBox>

                <!-- Control Bar -->
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Cổng Port:" style="-fx-text-fill: #334155; -fx-font-weight: bold;"/>
                    <TextField fx:id="txtPort" text="8080" prefWidth="75" style="-fx-font-size: 13px; -fx-padding: 6 8; -fx-border-color: #CBD5E1; -fx-border-radius: 6;"/>

                    <Button fx:id="btnStartServer" text="Bật Máy Chủ" onAction="#handleStartServer" styleClass="btn-primary"/>
                    <Button fx:id="btnStopServer" text="Tắt Máy Chủ" onAction="#handleStopServer" styleClass="btn-danger" disable="true"/>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Button text="Mở Thư Mục Web" onAction="#handleBrowseWebRoot" styleClass="btn-secondary"/>
                    <Button text="Xóa Nhật Ký" onAction="#handleClearScreen" styleClass="btn-secondary"/>
                </HBox>

                <!-- File Picker Toolbar -->
                <HBox spacing="10" alignment="CENTER_LEFT" styleClass="file-picker-bar">
                    <Label text="Tự chọn file phát:" style="-fx-text-fill: #1E3A8A; -fx-font-size: 12px; -fx-font-weight: bold;"/>

                    <Button text="[+] Chọn Nhạc MP3" onAction="#handleSelectAudio" styleClass="btn-file-picker"/>
                    <Label fx:id="lblCurrentAudio" text="audio.mp3" maxWidth="150" style="-fx-text-fill: #0284C7; -fx-font-size: 11px; -fx-font-family: 'Consolas', monospace; -fx-font-weight: bold;"/>

                    <Separator orientation="VERTICAL" prefHeight="16"/>

                    <Button text="[+] Chọn Video MP4" onAction="#handleSelectVideo" styleClass="btn-file-picker"/>
                    <Label fx:id="lblCurrentVideo" text="video.mp4" maxWidth="150" style="-fx-text-fill: #059669; -fx-font-size: 11px; -fx-font-family: 'Consolas', monospace; -fx-font-weight: bold;"/>

                    <Separator orientation="VERTICAL" prefHeight="16"/>

                    <Button text="[+] Chọn PDF" onAction="#handleSelectPdf" styleClass="btn-file-picker"/>
                    <Label fx:id="lblCurrentPdf" text="sample.pdf" maxWidth="150" style="-fx-text-fill: #D97706; -fx-font-size: 11px; -fx-font-family: 'Consolas', monospace; -fx-font-weight: bold;"/>
                </HBox>
            </VBox>
        </VBox>
    </top>

    <!-- Center: Live Terminal Log (Light Modern) -->
    <center>
        <VBox spacing="8" style="-fx-padding: 12 20;">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="Nhật Ký Kết Nối &amp; Phục Vụ 3 Dịch Vụ (Real-time Log):" style="-fx-text-fill: #1E3A8A; -fx-font-weight: bold; -fx-font-size: 13px;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="[Mẹo] Thiết bị khác gõ link LAN màu xanh bên trên để truy cập" style="-fx-text-fill: #059669; -fx-font-size: 12px; -fx-font-weight: 500;"/>
            </HBox>
            <TextArea fx:id="txtConsoleLog" editable="false" wrapText="true" VBox.vgrow="ALWAYS" styleClass="console-light"/>
        </VBox>
    </center>

    <!-- Bottom: Summary Stats -->
    <bottom>
        <HBox spacing="20" alignment="CENTER_LEFT" styleClass="footer-bar">
            <Label fx:id="lblSummary" text="Tổng yêu cầu đã nhận: 0 | Tổng lưu lượng: 0 B | Địa chỉ IP máy chủ: 127.0.0.1" style="-fx-text-fill: #475569; -fx-font-size: 12.5px; -fx-font-weight: 500;"/>
        </HBox>
    </bottom>

</BorderPane>
