<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.fiwpr06.websocket.client.controller.HistoryController"
      spacing="14" prefWidth="750" prefHeight="550"
      style="-fx-background-color: #F8FAFC; -fx-padding: 20;">

    <VBox spacing="4">
        <Text text="🕒 Lịch Sử Duyệt Web (Browsing History)" style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-fill: #0F172A;"/>
        <Text text="Danh sách các trang web đã truy cập được lưu trữ trong cơ sở dữ liệu." style="-fx-font-size: 13px; -fx-fill: #64748B;"/>
    </VBox>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <TextField fx:id="txtSearch" HBox.hgrow="ALWAYS" promptText="🔍 Tìm kiếm trong lịch sử theo tiêu đề hoặc URL..." onKeyReleased="#handleFilter" style="-fx-font-size: 13px; -fx-padding: 7 12;"/>
        <Button text="🌐 Mở lại trang này" onAction="#handleOpenSelected" style="-fx-background-color: #0284C7; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 7 14; -fx-cursor: hand; -fx-background-radius: 6;"/>
        <Button text="🗑️ Xóa mục chọn" onAction="#handleDeleteSelected" style="-fx-background-color: #EF4444; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 7 14; -fx-cursor: hand; -fx-background-radius: 6;"/>
        <Button text="⚠️ Xóa tất cả" onAction="#handleClearAll" style="-fx-background-color: #64748B; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 7 14; -fx-cursor: hand; -fx-background-radius: 6;"/>
    </HBox>

    <TableView fx:id="tblHistory" VBox.vgrow="ALWAYS">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="colTitle" text="Tiêu đề trang web" minWidth="220"/>
            <TableColumn fx:id="colUrl" text="Địa chỉ URL" minWidth="260"/>
            <TableColumn fx:id="colTime" text="Thời gian truy cập" minWidth="150" maxWidth="170"/>
        </columns>
    </TableView>

</VBox>
