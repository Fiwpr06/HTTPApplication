<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.fiwpr06.websocket.server.controller.ServerController"
            stylesheets="@../css/server-style.css" prefWidth="1050" prefHeight="720">

    <!-- Top Header & Telemetry HUD -->
    <top>
        <VBox spacing="14" styleClass="header-panel">
            <HBox alignment="CENTER_LEFT" spacing="16">
                <VBox spacing="2" HBox.hgrow="ALWAYS">
                    <Text text="⚡ WebServerPro — HTTP Server Dashboard" styleClass="title-text"/>
                    <Text text="Bài Lab 4: Hệ Thống Web Server Đa Dịch Vụ Mạng (VKU LTM)" styleClass="subtitle-text"/>
                </VBox>
                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <Label fx:id="lblDbBadge" text="DATABASE: MYSQL" styleClass="badge-db"/>
                    <Label fx:id="lblStatusBadge" text="🔴 SERVER STOPPED" styleClass="badge-offline"/>
                </HBox>
            </HBox>

            <!-- Control & Configuration Bar -->
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label text="Cổng Port:" style="-fx-text-fill: #94A3B8; -fx-font-weight: bold;"/>
                <TextField fx:id="txtPort" text="8080" prefWidth="80"/>

                <Label text="Thư mục Web Root:" style="-fx-text-fill: #94A3B8; -fx-font-weight: bold;"/>
                <TextField fx:id="txtWebRoot" text="web_root" prefWidth="240" editable="false"/>
                <Button fx:id="btnBrowseWebRoot" text="📂 Chọn thư mục" onAction="#handleBrowseWebRoot" styleClass="btn-secondary"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Button fx:id="btnStartServer" text="▶ Bật Server" onAction="#handleStartServer" styleClass="btn-success"/>
                <Button fx:id="btnStopServer" text="⏹ Tắt Server" onAction="#handleStopServer" styleClass="btn-danger" disable="true"/>
                <Button fx:id="btnCopyUrl" text="🔗 Sao chép URL" onAction="#handleCopyUrl" styleClass="btn-secondary"/>
                <Button fx:id="btnOpenBrowser" text="🌐 Mở Trình Duyệt" onAction="#handleOpenBrowser" styleClass="btn-primary"/>
            </HBox>

            <!-- Stat Cards -->
            <HBox spacing="14">
                <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                    <Text text="TỔNG YÊU CẦU (REQUESTS)" styleClass="stat-label"/>
                    <Text fx:id="lblTotalRequests" text="0" styleClass="stat-value"/>
                </VBox>
                <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                    <Text text="LƯU LƯỢNG TRUYỀN (BANDWIDTH)" styleClass="stat-label"/>
                    <Text fx:id="lblTotalBytes" text="0 B" styleClass="stat-value"/>
                </VBox>
                <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                    <Text text="IP MÁY CHỦ (LOCAL IP)" styleClass="stat-label"/>
                    <Text fx:id="lblLocalIp" text="127.0.0.1" styleClass="stat-value" style="-fx-fill: #2EE68A;"/>
                </VBox>
                <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                    <Text text="DỊCH VỤ SẴN SÀNG" styleClass="stat-label"/>
                    <Text text="HTML/MP4/MP3/PDF/ZIP" styleClass="stat-value" style="-fx-font-size: 16px;"/>
                </VBox>
            </HBox>
        </VBox>
    </top>

    <!-- Center: Realtime Live Request Log Table -->
    <center>
        <VBox spacing="10">
            <padding>
                <Insets top="14" right="24" bottom="14" left="24"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="12">
                <Text text="📋 Nhật Ký Yêu Cầu HTTP Thời Gian Thực (Live Access Logs)" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-fill: #E2E8F0;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <TextField fx:id="txtSearch" promptText="🔍 Lọc theo IP, URI hoặc Method..." prefWidth="260" onKeyReleased="#handleFilterLogs"/>
                <Button text="🔄 Tải lại CSDL" onAction="#handleReloadLogs" styleClass="btn-secondary"/>
                <Button text="🗑️ Xóa màn hình" onAction="#handleClearScreen" styleClass="btn-secondary"/>
            </HBox>

            <TableView fx:id="tblLogs" VBox.vgrow="ALWAYS">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colId" text="# ID" minWidth="60" maxWidth="70"/>
                    <TableColumn fx:id="colTime" text="Thời gian" minWidth="140" maxWidth="160"/>
                    <TableColumn fx:id="colIp" text="IP Khách" minWidth="120" maxWidth="140"/>
                    <TableColumn fx:id="colMethod" text="Method" minWidth="75" maxWidth="90"/>
                    <TableColumn fx:id="colUri" text="Đường dẫn (URI)" minWidth="220"/>
                    <TableColumn fx:id="colStatus" text="Mã HTTP" minWidth="85" maxWidth="95"/>
                    <TableColumn fx:id="colLength" text="Dung lượng" minWidth="100" maxWidth="120"/>
                    <TableColumn fx:id="colUserAgent" text="User-Agent" minWidth="160"/>
                </columns>
            </TableView>
        </VBox>
    </center>

</BorderPane>
